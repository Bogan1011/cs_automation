# Copy to .env and fill in. NEVER commit .env.

# Fernet key that encrypts the Vision One API keys at rest.
# Generate with: docker compose run --rm app python -m app.cli gen-key
MASTER_KEY=

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Separate sign-ins for each teammate (their name shows on work-board updates):
# DASHBOARD_USERS=akshay:long-password-1,colleague:long-password-2
DASHBOARD_USERS=
# Trend Business Success pages read for the latest articles (comma-separated, public pages only)
TREND_ARTICLE_URLS=https://success.trendmicro.com/en-US/product/?name=trend-vision-one
SESSION_SECRET=change-me-to-a-long-random-string

# Poll interval in seconds (default 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300
# Days of snapshot history to keep
RETENTION_DAYS=90

# Postgres (used by docker-compose)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://v1dash:change-me@db:5432/v1dash

# Outlook / Microsoft 365 via Microsoft Graph. No admin? Set only TENANT and CLIENT ID (delegated Mail.ReadWrite,
# public client flows on), then run: docker compose exec -it app python -m app.cli graph-login
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox the draft is created in, e.g. akshay@eventussecurity.com
GRAPH_MAILBOX=
# Mailbox that receives Trend support case emails (defaults to GRAPH_MAILBOX). The app needs Mail.Read.
CASES_MAILBOX=

# Which address the dashboard listens on. 127.0.0.1 = this server only.
# Set to the server's LAN IP (e.g. 192.168.1.67) to open it to your network.
BIND_ADDR=127.0.0.1
